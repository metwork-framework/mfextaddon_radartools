+
+  GRIBS_SET( *buf );
+  GRIBS_DECODE_BYT(4, ascii_GRIB);
+  if ( strcmp( "GRIB", ascii_GRIB ) != 0 ) {
+    return( RETURN_ERR );
+  }
+  GRIBS_DECODE_INT(3, &section0->length );
+  GRIBS_DECODE_INT(1, &section0->edition);
+  GRIBS_GET( *buf );
+
+  return ( RETURN_OK );
+}
