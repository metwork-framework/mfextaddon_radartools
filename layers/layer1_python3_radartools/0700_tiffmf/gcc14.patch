@@ -7,6 +7,80 @@
 #include <stdio.h>
 #include <string.h>
 
+/*===================================================================*/
+  PUBLIC RETURN_CODE GribsEncodeInt(n,i,b)
+/*===================================================================*/
+int n;
+int i;
+BYTE *b;
+{
+  int q, r;
+
+  if ( n == 1 ) {
+    *b = i;
+    return( RETURN_OK);
+  }
+  else {
+    q = i / 256;
+    r = i % 256;
+    b[n-1] = r;
+  GribsEncodeInt(n-1,q,b); 
+  }
+}
+
+/*===================================================================*/
+ PUBLIC RETURN_CODE GribsDecodeInt(n,i,b)
+/*===================================================================*/
+int n;
+int *i;
+BYTE *b;
+{
+  int j;
+  
+  *i=0;
+  for(j=0; j<n; j++) {
+    *i = 256 * *i + b[j]; 
+  }
+
+  return(RETURN_OK);
+}
+
+/*===================================================================*/
+ PUBLIC RETURN_CODE GribsEncodeIntSign(n,i,b)
+/*===================================================================*/
+int n;
+int i;
+BYTE *b;
+{
+  if ( i >= 0  ) {
+    GribsEncodeInt(n,i,b);
+  }
+  else {
+    GribsEncodeInt(n,-i,b);
+    b[0] = 0x80 | b[0];
+  }
+  return( RETURN_OK );
+}
+
+/*===================================================================*/
+ PUBLIC RETURN_CODE GribsDecodeIntSign(n,i,b)
+/*===================================================================*/
+int n;
+int *i;
+BYTE *b;
+{
+
+  if ( (b[0] & 0x80) == 0x80 ) {
+    b[0] = b[0] & 0x7f;
+    GribsDecodeInt(n,i,b);
+    *i= - *i;
+    b[0] = b[0] | 0x80;
+  }
+  else {
+    return ( GribsDecodeInt(n,i,b) );
+  }
+}
+
 #define GRIBS_SET(p) ptr=p
 #define GRIBS_ENCODE_INT(n,v) GribsEncodeInt(n,v,ptr); ptr+=n
 #define GRIBS_ENCODE_INS(n,v) GribsEncodeIntSign(n,v,ptr); ptr+=n
