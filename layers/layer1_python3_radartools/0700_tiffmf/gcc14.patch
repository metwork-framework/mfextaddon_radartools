+/*===================================================================*/
+ PUBLIC RETURN_CODE GribsCmsGrpAdd(dirname, grpname) 
+/*===================================================================*/
+char *dirname;
+char *grpname;
+{
+  int i;
+  FILE *fds, *fdp;
+  int len;
+  char *fname;
+
+fprintf (stderr,"GribsCmsGrpAdd\n");
+
+  if ( ggribs.ngrp < GRIBS_MAX_GRP ) {
+
+     i = ggribs.ngrp;
+     ggribs.grp[i].igrp = i; 
+     ggribs.grp[i].name = grpname; 
+
+     len = strlen(dirname) + 1 + strlen(grpname) + 1 + 3 + 1;
+     fname = MALLOCN( len, char );
+     strcpy( fname, dirname );
+     strcat( fname, "/");
+     strcat( fname, grpname );
+     strcat( fname, ".SAT" );
+     fds = fopen( fname, "r" );
+     strcpy( fname, dirname );
+     strcat( fname, "/");
+     strcat( fname, grpname );
+     strcat( fname, ".PRD" );
+     fdp = fopen( fname, "r" );
+     GribsCmsGrpRead( fds, fdp, &ggribs.grp[i] );
+     fclose(fds);
+     fclose(fdp);
+   
+     ggribs.ngrp++;
+     return( RETURN_OK );
+  }
+  else {
+    return( RETURN_ERR );
+  }
+}
